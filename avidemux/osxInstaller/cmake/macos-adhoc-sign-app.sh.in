#!/bin/bash
set -euo pipefail

BUNDLE="@BUNDLE@"
[[ -d "$BUNDLE" ]] || { echo "Bundle not found: $BUNDLE" >&2; exit 1; }

# The release build is unsigned, but every nested Mach-O must have an ad-hoc
# signature so Gatekeeper and the dynamic loader can validate the bundle.
/usr/bin/codesign --force --deep --sign - --timestamp=none "$BUNDLE"
/usr/bin/codesign --verify --deep --strict --verbose=2 "$BUNDLE"
